[Unit]
Description=Construire et publier la documentation
After=forgejo.service

[Service]
Type=oneshot
User=knowledge
Group=knowledge
SupplementaryGroups=forgejo
ExecStart=/opt/knowledge/venv/bin/python /usr/local/lib/knowledge/publish.py /etc/knowledge/publish.json
TimeoutStartSec=300
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/knowledge
ReadOnlyPaths=/var/lib/forgejo/repositories
InaccessiblePaths=/var/lib/forgejo/data /etc/forgejo
